<?xml version="1.0"?>

<!DOCTYPE rdf:RDF [
    <!ENTITY owl "http://www.w3.org/2002/07/owl#" >
    <!ENTITY xsd "http://www.w3.org/2001/XMLSchema#" >
    <!ENTITY rdfs "http://www.w3.org/2000/01/rdf-schema#" >
    <!ENTITY rdf "http://www.w3.org/1999/02/22-rdf-syntax-ns#" >
]>

<rdf:RDF xmlns="http://example.org/"
     xml:base="http://example.org/"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">

    <owl:Ontology rdf:about="http://example.org/"/>

    <!-- Object Properties -->
    <owl:ObjectProperty rdf:about="http://example.org/hasName"/>
    <owl:ObjectProperty rdf:about="http://example.org/hasCar"/>
    <owl:ObjectProperty rdf:about="http://example.org/hasPet"/>
    <owl:ObjectProperty rdf:about="http://example.org/hasHobby"/>

    <!-- Classes -->
    <owl:Class rdf:about="http://example.org/Person"/>

    <!-- ================= POSITIVE BEISPIELE (Streng nach Vorschrift) ================= -->
    <owl:NamedIndividual rdf:about="http://example.org/Alice">
        <rdf:type rdf:resource="http://example.org/Person"/>
        <hasName rdf:resource="http://example.org/NameAlice"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/Bob">
        <rdf:type rdf:resource="http://example.org/Person"/>
        <hasName rdf:resource="http://example.org/NameBob"/>
    </owl:NamedIndividual>

    <!-- ================= NEGATIVE BEISPIELE (Haben unerlaubte Extra-Eigenschaften) ================= -->
    <owl:NamedIndividual rdf:about="http://example.org/Charlie">
        <rdf:type rdf:resource="http://example.org/Person"/>
        <hasName rdf:resource="http://example.org/NameCharlie"/>
        <hasCar rdf:resource="http://example.org/Toyota"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/Dave">
        <rdf:type rdf:resource="http://example.org/Person"/>
        <hasName rdf:resource="http://example.org/NameDave"/>
        <hasPet rdf:resource="http://example.org/Dog"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/Eve">
        <rdf:type rdf:resource="http://example.org/Person"/>
        <hasName rdf:resource="http://example.org/NameEve"/>
        <hasHobby rdf:resource="http://example.org/Tennis"/>
    </owl:NamedIndividual>

    <!-- Dummy Leaf Nodes -->
    <owl:NamedIndividual rdf:about="http://example.org/NameAlice"/>
    <owl:NamedIndividual rdf:about="http://example.org/NameBob"/>
    <owl:NamedIndividual rdf:about="http://example.org/NameCharlie"/>
    <owl:NamedIndividual rdf:about="http://example.org/NameDave"/>
    <owl:NamedIndividual rdf:about="http://example.org/NameEve"/>
    <owl:NamedIndividual rdf:about="http://example.org/Toyota"/>
    <owl:NamedIndividual rdf:about="http://example.org/Dog"/>
    <owl:NamedIndividual rdf:about="http://example.org/Tennis"/>

</rdf:RDF>