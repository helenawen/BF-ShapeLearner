<?xml version="1.0"?>

<!DOCTYPE rdf:RDF [
    <!ENTITY owl "http://www.w3.org/2002/07/owl#" >
    <!ENTITY xsd "http://www.w3.org/2001/XMLSchema#" >
    <!ENTITY rdfs "http://www.w3.org/2000/01/rdf-schema#" >
    <!ENTITY rdf "http://www.w3.org/1999/02/22-rdf-syntax-ns#" >
]>

<rdf:RDF xmlns="http://example.org/"
     xml:base="http://example.org/"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">

    <owl:Ontology rdf:about="http://example.org/"/>

    <!-- Object Properties -->
    <owl:ObjectProperty rdf:about="http://example.org/hasChild"/>
    <owl:ObjectProperty rdf:about="http://example.org/hasCar"/>

    <!-- Classes -->
    <owl:Class rdf:about="http://example.org/Person"/>
    <owl:Class rdf:about="http://example.org/Vehicle"/>

    <!-- Individuals -->
    <owl:NamedIndividual rdf:about="http://example.org/Alice">
        <rdf:type rdf:resource="http://example.org/Person"/>
        <hasChild rdf:resource="http://example.org/AliceChild"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/Bob">
        <rdf:type rdf:resource="http://example.org/Person"/>
        <hasChild rdf:resource="http://example.org/BobChild"/>
        <hasCar rdf:resource="http://example.org/BobCar"/>
    </owl:NamedIndividual>

    <!-- Successors -->
    <owl:NamedIndividual rdf:about="http://example.org/AliceChild">
        <rdf:type rdf:resource="http://example.org/Person"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/BobChild">
        <rdf:type rdf:resource="http://example.org/Person"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/BobCar">
        <rdf:type rdf:resource="http://example.org/Vehicle"/>
    </owl:NamedIndividual>

</rdf:RDF>