<?xml version="1.0"?>

<!DOCTYPE rdf:RDF [
    <!ENTITY owl "http://www.w3.org/2002/07/owl#" >
    <!ENTITY xsd "http://www.w3.org/2001/XMLSchema#" >
    <!ENTITY rdfs "http://www.w3.org/2000/01/rdf-schema#" >
    <!ENTITY rdf "http://www.w3.org/1999/02/22-rdf-syntax-ns#" >
]>

<rdf:RDF xmlns="http://example.org/"
     xml:base="http://example.org/"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">

    <owl:Ontology rdf:about="http://example.org/"/>

    <!-- Object Properties -->
    <owl:ObjectProperty rdf:about="http://example.org/worksFor"/>

    <!-- Classes -->
    <owl:Class rdf:about="http://example.org/Person"/>
    <owl:Class rdf:about="http://example.org/Company"/>

    <!-- Individuals -->

    <!-- Bob points TO AcmeCorp -->
    <owl:NamedIndividual rdf:about="http://example.org/Alice">
        <rdf:type rdf:resource="http://example.org/Person"/>
        <worksFor rdf:resource="http://example.org/Company1"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/Bob">
        <rdf:type rdf:resource="http://example.org/Person"/>
        <worksFor rdf:resource="http://example.org/Company1"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/Bob">
        <rdf:type rdf:resource="http://example.org/Person"/>
        <worksFor rdf:resource="http://example.org/Company2"/>
    </owl:NamedIndividual>

    <!-- Companies -->
    <owl:NamedIndividual rdf:about="http://example.org/Company1">
        <rdf:type rdf:resource="http://example.org/Company"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/Company2">
        <rdf:type rdf:resource="http://example.org/Company"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/Company3">
        <rdf:type rdf:resource="http://example.org/Company"/>
    </owl:NamedIndividual>

</rdf:RDF>